[Unit]
Description=NCLE Web FastAPI Backend
After=network.target

[Service]
Type=simple
User=ianms
Group=ianms
WorkingDirectory=/home/ianms/git_repos/NCLEweb
Environment="PATH=/home/ianms/git_repos/NCLEweb/venv/bin"

# Run with Gunicorn for production (4 workers)
ExecStart=/home/ianms/git_repos/NCLEweb/venv/bin/gunicorn \
    -w 4 \
    -k uvicorn.workers.UvicornWorker \
    --bind 127.0.0.1:8000 \
    --timeout 300 \
    --access-logfile /home/ianms/git_repos/NCLEweb/logs/access.log \
    --error-logfile /home/ianms/git_repos/NCLEweb/logs/error.log \
    --log-level info \
    py.backend:app

# Restart policy
Restart=always
RestartSec=3

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nclweb

[Install]
WantedBy=multi-user.target
