[Unit]
Description=NCLE Web FastAPI Backend
After=network.target

[Service]
Type=simple
User=ianms
Group=ianms
WorkingDirectory=/home/ianms/git_repos/NCLEweb
Environment="PATH=/home/ianms/miniconda3/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Run with Gunicorn for production (4 workers) using base conda environment
ExecStart=/home/ianms/miniconda3/bin/python -m gunicorn \
# Restart policy
Restart=always
RestartSec=3

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nclweb

[Install]
WantedBy=multi-user.target
